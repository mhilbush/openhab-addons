	<!-- Generic Fallback Device -->
	<thing-type id="generic">
		<supported-bridge-type-refs>
			<bridge-type-ref id="account"/>
		</supported-bridge-type-refs>
		<label>ThermoWorks Generic Device</label>
		<description>Fallback description for unclassified ThermoWorks Cloud devices</description>

		<channels>
			<channel id="online" typeId="online"/>
			<channel id="last-updated" typeId="timestamp"/>
			<channel id="battery-level" typeId="system.battery-level"/>
			<channel id="battery-state" typeId="battery-state"/>
			<channel id="rssi" typeId="rssi"/>

			<channel id="probe1-temperature" typeId="temperature"/>
			<channel id="probe1-label" typeId="label"/>
			<channel id="probe1-alarm" typeId="alarm"/>
		</channels>

		<representation-property>serialNumber</representation-property>
		<config-description-ref uri="thing-type:thermoworks:device"/>
	</thing-type>

	<!-- Channel Type Definitions -->
	<channel-type id="battery-state" advanced="true">
		<item-type>String</item-type>
		<label>Battery State</label>
		<description>Current battery state of the device</description>
		<category>Text</category>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="rssi" advanced="true">
		<item-type>Number</item-type>
		<label>Signal Strength</label>
		<description>Wi-Fi or gateway signal strength in dBm</description>
		<category>QualityOfService</category>
		<state readOnly="true" pattern="%d dBm"/>
	</channel-type>

	<channel-type id="temperature">
		<item-type>Number:Temperature</item-type>
		<label>Temperature</label>
		<description>Current temperature reading</description>
		<category>Temperature</category>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="label">
		<item-type>String</item-type>
		<label>Probe Label</label>
		<description>Custom user label for the probe</description>
		<category>Text</category>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="alarm">
		<item-type>Switch</item-type>
		<label>Alarm Triggered</label>
		<description>Indicates whether high or low alarm thresholds have been crossed</description>
		<category>Alarm</category>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="online">
		<item-type>Switch</item-type>
		<label>Online</label>
		<description>Indicates whether device is online</description>
		<category>Switch</category>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="timestamp">
		<item-type>DateTime</item-type>
		<label>Last Updated</label>
		<description>Timestamp of the last update</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="enabled">
		<item-type>Switch</item-type>
		<label>Alarm Enabled</label>
		<description>Indicates whether the alarm is enabled</description>
		<category>Switch</category>
		<state readOnly="true"/>
	</channel-type>

</thing:thing-descriptions>
